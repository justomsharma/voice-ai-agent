# Copy this file to .env (git-ignored) and paste your keys after the "=".
# Real environment variables win over this file.
# Never commit .env, never paste keys into code, chats or screenshots.

# 04_stt (gpt-transcribe, gpt-live-transcribe) and 05_llm (gpt-6-luna): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional second batch provider (nova-3): https://console.deepgram.com
DEEPGRAM_API_KEY=
